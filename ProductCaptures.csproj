<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.1.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**;tests/**</DefaultItemExcludes>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="adapters/*.mjs;adapters/package.json;adapters/package-lock.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
